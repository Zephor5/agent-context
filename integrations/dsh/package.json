{
  "name": "dsh-agent-context",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "agent-context for DeepSeek Harness: registers the agent-context MCP server (stdio) so a DSH session shares one personal wiki vault and blackboard with every other agent tool on the machine.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib/*.js",
    "README.md"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "agent-context",
    "wiki",
    "blackboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zephor5/agent-context.git",
    "directory": "integrations/dsh"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
